{
  "name": "docfai",
  "version": "1.0.48",
  "private": true,
  "author": "Julien",
  "license": "MIT",
  "description": "Windows desktop app that turns screen recordings into step-by-step guides",
  "repository": {
    "type": "git",
    "url": "https://github.com/Julienbase/Docfai.git"
  },
  "main": "public/electron.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "electron": "electron .",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.cjs",
    "electron-dev": "npm run fetch:ffmpeg && concurrently \"npm run dev\" \"wait-on http://localhost:5180 && electron .\"",
    "electron-build": "npm run fetch:ffmpeg && npm run build && electron-builder --config electron-builder.config.js",
    "dist": "npm run fetch:ffmpeg && npm run build && electron-builder --config electron-builder.config.js --publish=never",
    "build-translation-module": "node scripts/build-translation-module.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security",
    "build:native": "node-gyp rebuild"
  },
  "dependencies": {
    "@types/lodash.debounce": "^4.0.9",
    "@types/uuid": "^10.0.0",
    "canvas": "^3.2.3",
    "clsx": "^2.0.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "docx": "^8.5.0",
    "dompurify": "^3.3.0",
    "electron-localshortcut": "^3.2.1",
    "electron-log": "^5.4.4",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.11",
    "file-saver": "^2.0.5",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.4.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.1.0",
    "jszip": "^3.10.2",
    "koffi": "^2.16.3",
    "lodash.debounce": "^4.0.8",
    "lucide-react": "^0.577.0",
    "node-fetch": "^3.3.2",
    "pptxgenjs": "^3.12.0",
    "python-shell": "^5.0.0",
    "quill": "2.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.1.3",
    "react-quill": "^2.0.0",
    "react-router-dom": "^6.20.1",
    "reactflow": "^11.11.4",
    "recharts": "^2.8.0",
    "sharp": "^0.35.4",
    "sonner": "^1.2.4",
    "tailwind-merge": "^2.6.1",
    "uuid": "^11.1.0",
    "yauzl": "^3.4.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.6.1",
    "babel-plugin-react-dev-locator": "^1.0.6",
    "concurrently": "^8.2.2",
    "electron": "^42.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-security": "^4.2.0",
    "globals": "^16.5.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^11.3.0",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.31",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.12",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "react-quill": {
      "quill": "2.0.2"
    },
    "pptxgenjs": {
      "image-size": "^2.0.4"
    }
  }
}
